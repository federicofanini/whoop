# ---------------------------------------------------------------------------
# WHOOP OAuth (https://developer-dashboard.whoop.com)
# Redirect URI must match exactly, e.g. http://localhost:3000/api/auth/whoop/callback
# ---------------------------------------------------------------------------
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/auth/whoop/callback

# Shared secret WHOOP signs webhook deliveries with (same value as the client secret
# unless your app is configured otherwise).
WHOOP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Database (Supabase Postgres, or any Postgres connection string)
# Required for friends: the friend graph and handles live here.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase — Google sign-in and the live heart-rate broadcast.
#
# Enable the Google provider under Authentication → Providers, and add
# <your-origin>/auth/callback to the redirect allow-list.
#
# The anon key is meant to be public: it is protected by row-level security and
# is the key the browser is supposed to hold.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Protects /api/cron/reconcile. Vercel Cron sends it as a Bearer token.
# ---------------------------------------------------------------------------
CRON_SECRET=
