# ---------------------------------------------------------------------------
# WHOOP OAuth (https://developer-dashboard.whoop.com)
# Redirect URI must match exactly, e.g. http://localhost:3000/api/auth/whoop/callback
# ---------------------------------------------------------------------------
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/auth/whoop/callback

# Shared secret WHOOP signs webhook deliveries with (same value as the client secret
# unless your app is configured otherwise).
WHOOP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Database (Supabase Postgres, or any Postgres connection string)
# Required for friends: the friend graph and handles live here.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Telegram — Strap Bot, which is how members sign in today.
#
# Create the bot with @BotFather, then point its webhook at this deployment:
#   bun run telegram set-webhook --url https://<your-domain>
#
# See docs/auth/strap-bot.md for the full bot specification.
# ---------------------------------------------------------------------------

# From @BotFather. Anyone holding this can send messages as the bot.
TELEGRAM_BOT_TOKEN=

# The bot's @name without the @, used to build the "open the bot" link on the
# sign-in page. Public by nature — it is printed on screen.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=strapbot

# Telegram echoes this back in the X-Telegram-Bot-Api-Secret-Token header on
# every delivery, which is what stops anyone else posting to the webhook.
# `openssl rand -hex 32`. Unset means the webhook refuses everything.
TELEGRAM_WEBHOOK_SECRET=

# Signs the session cookie issued after a correct login code. Any long random
# string; `openssl rand -hex 32`. Changing it signs everyone out.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Supabase — Google sign-in and the live heart-rate broadcast.
#
# Google sign-in is built but closed (see src/core/auth/providers.ts). These are
# still needed for the live heart-rate transport.
#
# When Google is opened: enable the provider under Authentication → Providers,
# and add <your-origin>/auth/callback to the redirect allow-list.
#
# The anon key is meant to be public: it is protected by row-level security and
# is the key the browser is supposed to hold.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# The deployment's own origin, used to build absolute redirect URLs from route
# handlers. Falls back to http://localhost:3000, which is wrong in production —
# set it there.
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Protects /api/cron/reconcile. Vercel Cron sends it as a Bearer token.
# ---------------------------------------------------------------------------
CRON_SECRET=

# Encrypts WHOOP client secrets that members paste in when bringing their own
# developer app. Any long random string; `openssl rand -hex 32` is fine.
# Changing it makes every stored key unreadable, so those members must re-add them.
CREDENTIALS_SECRET=

# How many members may share this deployment's WHOOP app. A WHOOP app in
# development is capped at 10 users by the platform; raise this only after the
# app is approved for production.
WHOOP_SHARED_USER_LIMIT=10
